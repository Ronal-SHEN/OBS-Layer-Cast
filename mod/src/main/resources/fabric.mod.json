{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Splits Minecraft HUD elements into independent transparent layers and shares them with OBS through GPU texture sharing.",
  "authors": ["OBS Layer Cast contributors"],
  "license": "MIT",
  "icon": "assets/layercast/icon.png",
  "contact": {
    "homepage": "https://github.com/Ronal-SHEN/OBS-Layer-Cast",
    "sources": "https://github.com/Ronal-SHEN/OBS-Layer-Cast"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["starship.layercast.fabric.LayerCastFabric"],
    "modmenu": ["starship.layercast.fabric.ModMenuIntegration"]
  },
  "mixins": ["layercast.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-rendering-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "malilib": "*",
    "java": ">=25"
  }
}
